# Multi-stage build for McCulloch Frontend

# Stage 1: Build the React application
FROM node:18-alpine AS build

# Accept build argument for API URL
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

WORKDIR /app

# Copy package files
COPY Client/package*.json ./

# Install all dependencies (including devDependencies needed for build)
# Use --include=dev to ensure devDependencies are installed even if NODE_ENV=production
RUN npm ci --include=dev && npm cache clean --force

# Copy source code
COPY Client/ .

# Build the application
RUN npm run build

# Stage 2: Production image with nginx
FROM nginx:alpine

# curl for the healthcheck; nodejs for the SEO head renderer (Client/seo/server.mjs)
RUN apk add --no-cache curl nodejs

# Copy built application from build stage
COPY --from=build /app/dist /usr/share/nginx/html

# SEO head renderer: page requests get a per-page <title>/meta/JSON-LD and a real
# 404 status; /sitemap.xml is generated from the API. Started by the nginx image's
# entrypoint hook below; restarted if it ever exits.
COPY Client/seo/server.mjs /opt/seo/server.mjs
COPY Client/src/content/infoPages.ts /opt/seo/infoPages.ts
RUN printf '#!/bin/sh\n(while :; do node /opt/seo/server.mjs; echo "[seo] exited, restarting"; sleep 2; done) &\n' \
      > /docker-entrypoint.d/40-seo-renderer.sh \
    && chmod +x /docker-entrypoint.d/40-seo-renderer.sh

# Add MIME types for videos (and the web app manifest) to the types block
RUN sed -i '/types {/a\    video/mp4                             mp4;\n    video/webm                            webm;\n    video/ogg                             ogv ogg;\n    application/manifest+json             webmanifest;' /etc/nginx/mime.types

# Create nginx configuration
RUN cat > /etc/nginx/conf.d/default.conf <<'EOF'
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # One address for Google: www → the bare domain, keeping the path (old indexed
    # URLs are mostly www; the SEO renderer then redirects any old-site paths).
    if ($host ~* ^www\.(.+)$) {
        return 301 https://$1$request_uri;
    }

    # Enable gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml application/xml+rss application/json;
    gzip_proxied any;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Pages: real files are served as-is; everything else goes to the SEO head
    # renderer (per-page meta + real 404s + /sitemap.xml). If the renderer is
    # unavailable, fall back to the plain SPA shell so the site still works.
    location / {
        try_files $uri @seo;
    }
    location = / {
        proxy_pass http://127.0.0.1:3001;
        proxy_connect_timeout 2s;
        proxy_read_timeout 8s;
        error_page 502 503 504 = @spa;
    }
    location @seo {
        proxy_pass http://127.0.0.1:3001;
        proxy_connect_timeout 2s;
        proxy_read_timeout 8s;
        error_page 502 503 504 = @spa;
    }
    location @spa {
        try_files /index.html =404;
    }

    # Blog: WordPress (Coolify service "mcclblog") on the shared coolify network.
    # ^~ keeps the image/video/font regex locations below from catching blog media.
    # The upstream is resolved per request via Docker DNS, so the shop still starts
    # if the blog container is down. WordPress re-adds /blog via WORDPRESS_CONFIG_EXTRA.
    location = /blog {
        absolute_redirect off;
        return 301 /blog/;
    }
    location ^~ /blog/ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $blog_upstream wordpress-p2b1ggayztc1otntrgexhwwr;
        rewrite ^/blog/(.*)$ /$1 break;
        proxy_pass http://$blog_upstream:80;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        client_max_body_size 64m;
    }

    # Cache static assets
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Cache images
    location ~* \.(jpg|jpeg|png|gif|ico|svg|webp|avif)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Cache videos - with proper MIME type
    location ~* \.(mp4|webm|ogg|mov)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        add_header Accept-Ranges bytes;
        access_log off;
    }

    # Cache fonts
    location ~* \.(woff|woff2|ttf|otf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Disable access to hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
EOF

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

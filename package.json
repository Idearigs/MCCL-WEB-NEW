{
  "name": "mcculloch-website",
  "version": "1.0.0",
  "description": "McCulloch Website - Client and Server",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" --names \"SERVER,CLIENT\" --prefix \"[{name}]\" --kill-others-on-exit",
    "dev:server": "cd Server && npm run dev",
    "dev:client": "cd Client && npm run dev",
    "build": "concurrently \"npm run build:server\" \"npm run build:client\"",
    "build:server": "cd Server && npm install",
    "build:client": "cd Client && npm install",
    "start": "concurrently \"npm run start:server\" \"npm run start:client\"",
    "start:server": "cd Server && npm start",
    "start:client": "cd Client && npm start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "stylelint-config-tailwindcss": "^1.0.0"
  }
}

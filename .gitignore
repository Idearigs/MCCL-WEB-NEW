# ============================================================
# McCulloch Website — .gitignore
# ============================================================

# Local archive (backup/junk files — stays on your machine only)
_archive/

# Dependencies
node_modules/
*/node_modules/

# Logs
*.log
logs/
npm-debug.log*

# Build outputs
dist/
build/
out/

# Environment variables (keep .env.example, never commit real .env)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE / OS files
.vscode/
.idea/
.DS_Store
.DS_Store?
Thumbs.db
*.swp
*.swo
*~

# Temporary / backup files
*.tmp
*.temp
*.old
*.new
nul
Server/nul

# Root-level junk (Windows artifacts, local-only)
public/

# Large media files (stored in Docker volumes on VPS, not in git)
*.mp4
*.mov
*.avi
*.mkv
*.webm

# Server uploads — stored in Docker volume, never in git
Server/uploads/

# Scraper data — large JSON + images, local use only
Server/scripts/*/output/
Server/scripts/festina-scraper/
Server/scripts/roamer-scraper/
Server/scripts/briston-scraper/output/

# Source images — large PNGs, stored on VPS only
Client/images/
